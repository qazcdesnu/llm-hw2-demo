# backend/.env 로 복사해서 사용한다. .env 는 git에 올리지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 추론 모델의 추론 강도 (minimal|low|medium|high). 추론을 지원하지 않는 모델(gpt-4.1-nano 등)이면 비워둔다.
OPENAI_REASONING_EFFORT=low
# 질문 작성(친구 말투 질문)의 모델(비우면 OPENAI_MODEL)과 추론 강도(기본 low, minimal은 빠르지만 규칙을 덜 지킴)
# OPENAI_QUESTION_MODEL=
# OPENAI_QUESTION_REASONING_EFFORT=low
# OPENAI_TIMEOUT=30
